# LLM + voice
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ATLAS_VOICE_ID=
AURA_REASONING_MODEL=gpt-4o

# Fleet endpoints
AURA_FLEET_HTTP=http://localhost:8780
AURA_FLEET_WS=ws://localhost:8780/fleet
AURA_AGENT_WS=ws://localhost:8770/aura

# Solana
HELIUS_RPC_URL=https://api.devnet.solana.com
HW_KEYPAIR_DIR=~/.config/aura

# Dashboard (NEXT_PUBLIC_* are exposed to the browser)
NEXT_PUBLIC_FLEET_HTTP=http://localhost:8780
NEXT_PUBLIC_AURA_WS=ws://localhost:8770/aura
NEXT_PUBLIC_FLEET_WS=ws://localhost:8780/fleet
